# Copy to .env locally. Never commit real API keys.
FISH_API_KEY=
# Optional: a voice reference ID from your Fish Audio account.
FISH_REFERENCE_ID=
# Optional model override. The default is Fish Audio's s2.1-pro-free.
FISH_MODEL=s2.1-pro-free

FAL_KEY=
# Optional fal model endpoint override.
FAL_ENDPOINT=https://fal.run/fal-ai/flux-2
