# Optional premium voice provider. If omitted, the free Edge TTS Russian voice is used.
FISH_API_KEY=
FISH_REFERENCE_ID=
FISH_MODEL=s2.1-pro-free

# Default free Russian neural narrator (no API key).
EDGE_TTS_VOICE=ru-RU-DmitryNeural
EDGE_TTS_RATE=+0%

# Optional AI background generation. Without this key, animated SVG backgrounds are used.
FAL_KEY=
FAL_ENDPOINT=https://fal.run/fal-ai/flux-2
