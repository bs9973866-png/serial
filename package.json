{
  "name": "chuzhaya-parta-ai-series",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "remotion studio src/index.ts",
    "typecheck": "tsc --noEmit",
    "render": "remotion render src/index.ts Episode out/episode-01.mp4",
    "render:ci": "remotion render src/index.ts Episode out/episode-01.mp4 --codec=h264 --crf=20 --concurrency=2",
    "still": "remotion still src/index.ts Episode out/episode-01-poster.png",
    "generate:assets": "node scripts/generate-episode-assets.mjs",
    "render:ai": "remotion render src/index.ts Episode out/episode-01.mp4 --codec=h264 --crf=20 --concurrency=2 --props='{\"voiceover\":true,\"aiVisuals\":true}'"
  },
  "dependencies": {
    "@remotion/cli": "^4.0.0",
    "remotion": "^4.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "typescript": "^5.4.0"
  }
}
